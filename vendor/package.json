{
  "name": "python-cheatsheet-vendor",
  "private": true,
  "version": "1.0.0",
  "description": "Builds a single bundled CodeMirror ESM file so pages load one copy of @codemirror/state (no CDN dedup issues, works offline).",
  "type": "module",
  "scripts": {
    "build": "esbuild src/codemirror-bundle.js --bundle --format=esm --minify --outfile=../assets/codemirror.min.js"
  },
  "devDependencies": {
    "@codemirror/lang-python": "6.1.6",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.2",
    "@codemirror/view": "6.43.13",
    "codemirror": "6.0.1",
    "esbuild": "0.24.2"
  }
}
